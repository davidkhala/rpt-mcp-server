{
  "name": "@davidkhala/rpt-mcp-server",
  "version": "0.1.0",
  "description": "MCP server for Crystal Reports .rpt files (via a .NET Framework integration)",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "crystal-reports"
  ],
  "license": "MIT",
  "author": "David Liu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidkhala/rpt-mcp-server.git"
  },
  "homepage": "https://github.com/davidkhala/rpt-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/davidkhala/rpt-mcp-server/issues"
  },
  "type": "module",
  "os": [
    "win32"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "powershell -NoProfile -ExecutionPolicy Bypass -File reader/build.ps1",
    "prepublishOnly": "npm run build",
    "start": "node src/index.js",
    "test": "mocha --timeout 120000 test/smoke.mjs"
  },
  "bin": {
    "rpt-mcp-server": "src/index.js"
  },
  "files": [
    "src",
    "reader/RptReader.cs",
    "reader/RptReader.exe",
    "reader/build.ps1"
  ],
  "dependencies": {
    "@modelcontextprotocol/server": "latest",
    "zod": "latest"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "mocha": "^12.0.3"
  }
}
